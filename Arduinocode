  int x = (y*9);
  System.out.println(y);
  fill(#DB2C2C);
  stroke(#6A1414);
  triangle(250,1000,380,1000,313,1000 - x); //redfire
  triangle(350,1000,480,1000,413,1000 - x);
  triangle(450,1000,580,1000,513,1000 - x);
  triangle(550,1000,680,1000,613,1000 - x);
  triangle(650,1000,780,1000,713,1000 - x);
 
  fill(#FFBF1A);
  noStroke();
  triangle(250,1000,380,1000,313,1300 - x); //orangefire
  triangle(350,1000,480,1000,413,1300 - x);
  triangle(450,1000,580,1000,513,1300 - x);
  triangle(550,1000,680,1000,613,1300 - x);
  triangle(650,1000,780,1000,713,1300 - x);
 
  fill(#FFE91A);
  triangle(250,1000,380,1000,313,1500 - x); //yellowfire
  triangle(350,1000,480,1000,413,1500 - x);
  triangle(450,1000,580,1000,513,1500 - x);
  triangle(550,1000,680,1000,613,1500 - x);
  triangle(650,1000,780,1000,713,1500 - x);
 
fill(206,171,119);
stroke(#836528);
ellipse(470,700,150,75); //leftleg
